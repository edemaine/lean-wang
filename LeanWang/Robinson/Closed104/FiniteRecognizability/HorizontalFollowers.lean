private theorem hFollowerTable_correct : hFollowerTable = indices.map rawHFollowers := by
  apply List.ext_getElem
  · decide +kernel
  · intro i hleft hright
    have hi : i < 104 := by simpa [indices] using hright
    have row := hFollowerTable_row_correct ⟨i, hi⟩
    simpa [followersAt, hleft, indices] using row


/-- Table lookup is exactly Wang matching. -/
theorem mem_hFollowersAt_iff (left right : Index) :
    right ∈ followersAt hFollowerTable left ↔
      WangTile.HMatches (tile (components left)) (tile (components right)) := by
  rw [hFollowerTable_correct]
  simp [followersAt, indices]
  change right ∈ indices.filter (fun r => decide (WangTile.HMatches
    (tile (components left)) (tile (components r)))) ↔ _
  simp [indices]

