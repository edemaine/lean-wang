private theorem vFollowerTable_correct : vFollowerTable = indices.map rawVFollowers := by
  apply List.ext_getElem
  · decide +kernel
  · intro i hleft hright
    have hi : i < 104 := by simpa [indices] using hright
    have row := vFollowerTable_row_correct ⟨i, hi⟩
    simpa [followersAt, hleft, indices] using row


/-- Table lookup is exactly Wang matching. -/
theorem mem_vFollowersAt_iff (left right : Index) :
    right ∈ followersAt vFollowerTable left ↔
      WangTile.VMatches (tile (components left)) (tile (components right)) := by
  rw [vFollowerTable_correct]
  simp [followersAt, indices]
  change right ∈ indices.filter (fun r => decide (WangTile.VMatches
    (tile (components left)) (tile (components r)))) ↔ _
  simp [indices]

