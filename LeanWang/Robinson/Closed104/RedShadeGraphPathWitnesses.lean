namespace LeanWang.OllingerRobinson.Figure13Layers.Closed104
namespace RedShadeGraphPathWitnesses
open RedShadeGraph RedShadeGraphSearch RedShadeGraphCertificate

abbrev EncodedNode := Nat × Nat × Bool × List Nat

private def decodePort (width code : Nat) : Port :=
  ⟨(code / 4) % width, (code / 4) / width,
    match code % 4 with
    | 0 => .west | 1 => .east | 2 => .south | _ => .north⟩

private def decodeMove (width code : Nat) : Move :=
  ⟨((code / 2) / 9) % width, ((code / 2) / 9) / width,
    match (code / 2) % 9 with
    | 0 => .horizontalMatch | 1 => .verticalMatch | 2 => .horizontal
    | 3 => .vertical | 4 => .westNorth | 5 => .westSouth
    | 6 => .eastNorth | 7 => .eastSouth | _ => .crossing,
    code % 2 == 1⟩

def decodeNodes (width : Nat) (nodes : List EncodedNode) : List Node :=
  nodes.map fun n =>
    ⟨decodePort width n.1, decodePort width n.2.1, n.2.2.1,
      n.2.2.2.map (decodeMove width)⟩

